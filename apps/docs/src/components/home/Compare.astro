---
// The same endpoint in Express and in Kaelum, side by side.
import { Code } from "@astrojs/starlight/components";

const express = `import express from "express";
import helmet from "helmet";
import { randomUUID } from "node:crypto";
import { z } from "zod";

const app = express();
app.disable("x-powered-by");
app.use(helmet());
app.use(express.json({ limit: "100kb" }));
app.use((req, res, next) => {
  res.setHeader("X-Request-Id", randomUUID());
  next();
});

const NewUser = z.object({ name: z.string().min(2) });

app.post("/users", async (req, res, next) => {
  try {
    const parsed = NewUser.safeParse(req.body);
    if (!parsed.success) {
      return res.status(400).json({ error: parsed.error.issues });
    }
    res.status(201).json(await db.users.create(parsed.data));
  } catch (err) {
    next(err);
  }
});

app.get("/health", (req, res) => res.json({ status: "ok" }));
app.use((req, res) => res.status(404).json({ error: "Not found" }));
app.use((err, req, res, next) => res.status(500).json({ error: "Internal error" }));

const server = app.listen(3000);
process.on("SIGTERM", () => server.close(() => process.exit(0)));`;

const kaelum = `import kaelum, { k } from "kaelum";

const app = kaelum();

app.post("/users", {
  body: k.object({ name: k.string().min(2) }),
  handler: (c) => c.created(db.users.create(c.body)),
});

await app.start(3000);`;

const lines = (code: string) => code.split(/\r?\n/).length;
---

<div class="k-compare not-content">
  <div class="k-compare__col">
    <p class="k-compare__label">Express <span>{lines(express)} lines</span></p>
    <Code code={express} lang="js" title="server.js" />
  </div>
  <div class="k-compare__col">
    <p class="k-compare__label k-compare__label--kaelum">Kaelum <span>{lines(kaelum)} lines</span></p>
    <Code code={kaelum} lang="ts" title="server.ts" />
  </div>
</div>

<style>
  .k-compare {
    display: grid;
    gap: 1.25rem;
    align-items: start;
    margin-top: 2rem;
  }

  @media (min-width: 62rem) {
    .k-compare {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }
  }

  .k-compare__col {
    min-width: 0;
  }

  .k-compare__label {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 0.6rem;
    color: var(--sl-color-gray-2);
    font-weight: 650;
  }

  .k-compare__label span {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-weight: 500;
  }

  .k-compare__label--kaelum {
    color: var(--sl-color-accent);
  }

  .k-compare :global(.expressive-code) {
    margin: 0;
  }
</style>
