{
  "name": "kaelum-api",
  "version": "0.1.0",
  "private": true,
  "description": "Kaelum TypeScript REST API",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/app.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/app.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "dependencies": {
    "kaelum": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
