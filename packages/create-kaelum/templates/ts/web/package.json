{
  "name": "kaelum-web",
  "version": "0.1.0",
  "private": true,
  "description": "Kaelum TypeScript web app",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "node --test",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "dependencies": {
    "kaelum": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
