{
  "name": "kaelum",
  "version": "1.10.4",
  "description": "A minimalist Node.js framework for building web pages and APIs with simplicity and speed.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "default": "./dist/validate.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:dist": "node --test \"test-dist/*.test.mjs\"",
    "prepack": "pnpm build && node -e \"const fs=require('fs');for(const f of ['README.md','LICENSE'])fs.copyFileSync('../../'+f,f)\""
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/matheusmessias"
  },
  "keywords": [
    "framework",
    "nodejs",
    "express",
    "kaelum",
    "api",
    "web",
    "minimal"
  ],
  "author": "Matheus Campagnolo",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaelumjs/kaelum.git",
    "directory": "packages/kaelum"
  },
  "bugs": {
    "url": "https://github.com/kaelumjs/kaelum/issues"
  },
  "homepage": "https://kaelumjs.matthcodes.dev",
  "dependencies": {
    "cors": "^2.8.6",
    "ejs": "^3.1.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "supertest": "7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
