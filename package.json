{
  "name": "kaelum",
  "version": "1.9.4",
  "description": "A minimalist Node.js framework for building web pages and APIs with simplicity and speed.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./validate": {
      "require": "./validate.js"
    },
    "./test": {
      "require": "./test.js"
    }
  },
  "bin": {
    "kaelum": "cli/index.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/matheusmessias"
  },
  "keywords": [
    "framework",
    "nodejs",
    "express",
    "cli",
    "kaelum",
    "api",
    "web",
    "minimal",
    "starter"
  ],
  "author": "Matheus Campagnolo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaelumjs/kaelum.git"
  },
  "bugs": {
    "url": "https://github.com/kaelumjs/kaelum/issues"
  },
  "homepage": "https://kaelumjs.matthcodes.dev",
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "ejs": "3.1.10",
    "express": "5.2.1",
    "fs-extra": "11.3.6",
    "helmet": "7.2.0",
    "inquirer": "12.11.1",
    "morgan": "1.11.0"
  },
  "devDependencies": {
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.4.2",
    "prettier": "3.9.3",
    "supertest": "7.2.2"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "^.*/validate\\.js$",
      "^.*/test\\.js$"
    ]
  }
}
